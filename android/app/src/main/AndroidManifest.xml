<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- So the app can hand the update apk it downloaded to the system
         installer. The person still has to allow this app as an install source
         once, and still confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Only for exporting saves to Downloads, and only before Android 10:
         from there a MediaStore insert needs no permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- A pad is another way of pressing the handset's keys, never the only
         one: the number pad has more keys than a pad has buttons, so the
         on-screen keypad is always there and a touchscreen is still required.
         Declared so a device that has a pad knows the app answers to it. -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <!-- A game, so the handset files it with its games: appCategory is what
         Android 8 and later read (Game Mode, the Play-less game lists), and
         isGame what older launchers and Samsung's Game Launcher read. -->
    <application
        android:appCategory="game"
        android:isGame="true"
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Mini Mobile"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The save zips handed to another app from 세이브 공유하기. -->
        <provider
            android:name=".SaveShareProvider"
            android:authorities="${applicationId}.saves"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Hears the result of the install session 업데이트 확인 commits, so it
             can launch the system's confirm screen and report how it went. -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jjongjjongs.minimobile.INSTALL_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
